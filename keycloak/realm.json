{
  "realm": "$(env:APP_NAME)",
  "displayName": "$(env:APP_NAME)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "roles": {
    "realm": [
      {
        "name": "administrateur",
        "description": "Administrateur de l'application : gestion des comptes (ADR-0005)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "name": "Application web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["$(env:PUBLIC_URL)/*", "http://localhost:5173/*"],
      "webOrigins": ["$(env:PUBLIC_URL)", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "$(env:PUBLIC_URL)/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mobile",
      "name": "Application mobile",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["$(env:APP_NAME)://*", "exp://*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "displayName": "Google",
      "enabled": "$(env:GOOGLE_ENABLED)",
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "$(env:GOOGLE_CLIENT_ID)",
        "clientSecret": "$(env:GOOGLE_CLIENT_SECRET)",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "microsoft",
      "providerId": "microsoft",
      "displayName": "Microsoft",
      "enabled": "$(env:MICROSOFT_ENABLED)",
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "$(env:MICROSOFT_CLIENT_ID)",
        "clientSecret": "$(env:MICROSOFT_CLIENT_SECRET)",
        "syncMode": "IMPORT"
      }
    }
  ]
}
