# Rempli automatiquement par le script du socle :
#   socle/scripts/ajouter-application.sh <nom> <ce-dossier>
# Le fichier .env n'est jamais versionné.

APP_NAME=
PUBLIC_URL=

# Image publiée par GitHub Actions et version déployée (« local » = construite sur ce PC).
IMAGE=ghcr.io/deteemma/modele-application
VERSION=local

# Base PostgreSQL du socle : compte applicatif (RLS) et compte propriétaire (migrations).
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

# Keycloak du socle (realm de l'application).
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=api

# Connexion Google / Microsoft (voir INSTALL.md). Vide = bouton désactivé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mobile hors ligne : COMPOSE_PROFILES=mobile-hors-ligne démarre PowerSync.
COMPOSE_PROFILES=
POWERSYNC_DATABASE_URL=
POWERSYNC_STORAGE_URL=

# Limites mémoire.
API_MEM_LIMIT=384m
MIGRATIONS_MEM_LIMIT=256m
POWERSYNC_MEM_LIMIT=512m
