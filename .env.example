# Rempli automatiquement par le script du socle :
#   socle/scripts/ajouter-application.sh <nom> <ce-dossier>
# Le fichier .env n'est jamais versionné.

APP_NAME=acta
PUBLIC_URL=

# Image publiée par GitHub Actions et version déployée (« local » = construite sur ce PC).
IMAGE=ghcr.io/deteemma/acta
VERSION=local

# Base PostgreSQL du socle : compte applicatif (RLS) et compte propriétaire (migrations).
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

# Keycloak du socle (realm de l'application).
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=api
# Secret du compte technique « api-admin » (administration des comptes), généré
# par socle/scripts/appliquer-realm.sh.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Connexion Google / Microsoft (voir INSTALL.md). Vide = bouton désactivé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mobile hors ligne : COMPOSE_PROFILES=mobile-hors-ligne démarre PowerSync.
COMPOSE_PROFILES=
POWERSYNC_DATABASE_URL=
POWERSYNC_STORAGE_URL=

# Assistant (Hermes + Ollama, INSTALL.md « Assistant ») : ajouter « assistant » à
# COMPOSE_PROFILES pour démarrer l'instance Hermes d'ACTA. Sans adresse ou sans
# clé, l'assistant n'apparaît pas dans ACTA.
#   HERMES_URL : http://assistant:8642 en production ; en local, le tunnel SSH
#                (http://host.docker.internal:8642, INSTALL.md).
#   HERMES_API_KEY : au moins 32 caractères aléatoires ; en local, celle du serveur.
#   OLLAMA_URL : adresse d'Ollama sur le réseau ${APP_NAME}-assistant-modele.
HERMES_URL=
HERMES_API_KEY=
OLLAMA_URL=http://ollama:11434

# Limites mémoire.
API_MEM_LIMIT=384m
MIGRATIONS_MEM_LIMIT=256m
POWERSYNC_MEM_LIMIT=512m
# Hermes : mem_limit et taille du tmpfs de ses données, à régler ensemble.
ASSISTANT_MEM_LIMIT=2g
ASSISTANT_TMPFS_SIZE=512m
