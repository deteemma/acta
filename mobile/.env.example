# Copier en mobile/.env. Adresse publique de l'application (PUBLIC_URL du .env racine).
EXPO_PUBLIC_API_URL=https://modele.localhost
# true : mode local-first avec PowerSync (ADR-0004). Exige un « development build »
# (npx expo run:android) : PowerSync utilise un module natif absent d'Expo Go.
EXPO_PUBLIC_HORS_LIGNE=false
